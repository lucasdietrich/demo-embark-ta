
# Yocto SDK
source /opt/amy/1.0/environment-setup-*

# OP-TEE, used by the TA Makefile
# TA dev kit (export-ta_<arch> of the OP-TEE OS build), shipped by the Yocto SDK
export TA_DEV_KIT_DIR="${TA_DEV_KIT_DIR:-$SDKTARGETSYSROOT/usr/include/optee/export-user_ta}"
# Signing key of the TA, default: keys/default_ta.pem of the TA dev kit
# export TA_SIGN_KEY=<path to the PEM key>
