CONFIG_EMBARK=y

#
# Embark general configuration
#
# CONFIG_EMBARK_DEBUG is not set
CONFIG_EMBARK_PROPAGATE_CONF=y
# CONFIG_TEST is not set
# end of Embark general configuration

#
# Project
#
CONFIG_PRODUCE_ELF=y
CONFIG_PRODUCE_COMPILE_COMMANDS=y
CONFIG_PROJECT_NAME="myta"
CONFIG_PROJECT_VERSION="0.1.0"
CONFIG_BUILD_DIR="build"
CONFIG_BUILD_DIR_FROM_ENV=""
# CONFIG_PROJECT_KIND_EXECUTABLE is not set
CONFIG_PROJECT_KIND_LIBRARY=y
# CONFIG_PROJECT_KIND_YOCTO is not set
# CONFIG_NATIVE is not set
CONFIG_CROSS=y
CONFIG_LINUX=y
# CONFIG_BARE_METAL is not set
# CONFIG_ZEPHYR is not set
# CONFIG_RTT is not set
CONFIG_CROSS_LINUX=y
CONFIG_DEFAULT_BUILD_TYPE_DEBUG=y
# CONFIG_DEFAULT_BUILD_TYPE_RELEASE is not set
# CONFIG_FETCHER_PREFERRED_GIT is not set
CONFIG_FETCHER_PREFERRED_ARCHIVE=y
# end of Project

CONFIG_TARGET_DEPLOY=y
CONFIG_TARGET_NAME="mpx"
CONFIG_TARGET_PATH="~"

#
# Languages Support
#
CONFIG_LANG_C=y
CONFIG_CLANGD=y
# CONFIG_CLANGD_SUPPRESS_NO_SPLIT_WIDE_TYPES_WARNING is not set
# CONFIG_CLANGD_SUPPRESS_NO_TREE_SCEV_CPROP_WARNING is not set
# CONFIG_CLANGD_REMOVE_GCC_ONLY_FLAGS is not set
CONFIG_CLANG_FORMAT=y
CONFIG_CLANG_FORMAT_AUTOFORMAT=y
CONFIG_CLANG_FORMAT_STYLE_MODERN=y
# CONFIG_CLANG_FORMAT_STYLE_LEGACY is not set
# CONFIG_CLANG_FORMAT_STYLE_ZEPHYR is not set

#
# c-libraries
#
# CONFIG_LIB_MYLIB is not set
# CONFIG_LIB_MBEDTLS is not set
# end of c-libraries

CONFIG_ENTRY_SYMBOL="main"
CONFIG_MAIN_ARGS=y

#
# Compiler Configuration
#
CONFIG_PREFIX="/usr"
CONFIG_INSTALL=y
CONFIG_INSTALL_DESTDIR="./sysroot"
CONFIG_INSTALL_YOCTO_SDK=y
CONFIG_CFLAGS_ALL=y
CONFIG_CFLAGS_EXTRA=y
CONFIG_CFLAGS_PEDANTIC=y
# CONFIG_CFLAGS_EVERYTHING is not set
# CONFIG_CFLAGS_WERROR is not set
CONFIG_CFLAGS_GNU_SOURCE=y
CONFIG_CFLAGS_ADDITIONAL=""
# end of Compiler Configuration

CONFIG_LANG_RUST=y
CONFIG_RUST_TOOLCHAIN_VERSION="1.97.1"
CONFIG_RUST_STD=y
CONFIG_RUST_TARGET_AARCH64_UNKNOWN_LINUX_GNUEABI=y
CONFIG_RUST_TARGET="aarch64-unknown-linux-gnu"
# CONFIG_RUST_CUSTOM_LINKER_SCRIPT is not set
CONFIG_RUST_RUNNER_QEMU=y
CONFIG_RUST_PANIC_ABORT=y
# CONFIG_RUST_PANIC_UNWIND is not set
CONFIG_CARGO=y
# CONFIG_CARGO_INIT is not set
CONFIG_RUST_SKELETON=y
# CONFIG_RUST_BUILD_SCRIPT is not set
CONFIG_RUST_EXAMPLE=y
CONFIG_RUST_EXAMPLE_NAME="example"
CONFIG_RUST_WRAPPER=y
# CONFIG_LANG_PYTHON is not set
# CONFIG_LANG_HELLO_WORLD is not set
# end of Languages Support

#
# Toolchain Configuration
#
# CONFIG_CROSS_ARCH_ARM is not set
CONFIG_CROSS_ARCH_AARCH64=y
# CONFIG_CROSS_ARCH_X86 is not set
# CONFIG_CROSS_ARCH_RISCV is not set
# CONFIG_CROSS_ARCH_AVR is not set
# CONFIG_RUST_FFI is not set

#
# Build System Configuration
#
# CONFIG_BUILD_SYSTEM_NONE is not set
CONFIG_BUILD_SYSTEM_MESON=y
# CONFIG_BUILD_SYSTEM_CMAKE is not set
# CONFIG_BUILD_SYSTEM_RUST is not set
# CONFIG_BUILD_MAKE is not set
# end of Build System Configuration

# CONFIG_TOOLCHAIN_GCC is not set
CONFIG_TOOLCHAIN_YOCTO_SDK=y

#
# Yocto SDK Configuration
#
CONFIG_TOOLCHAIN_YOCTO_SDK_PATH="/opt/amy/1.0"
CONFIG_TOOLCHAIN_YOCTO_SDK_ENV_SOURCE=y
# end of Yocto SDK Configuration

CONFIG_ADDITIONAL_CFLAGS=""
CONFIG_SHELL="/bin/bash"
CONFIG_ARCH_AARCH64=y
# end of Toolchain Configuration

CONFIG_QEMU=y
CONFIG_QEMU_TYPE_USER=y
CONFIG_QEMU_SYSROOT_REQUIRED=y
CONFIG_QEMU_EXE="qemu-aarch64"
CONFIG_QEMU_DEBUG_PORT=1234
CONFIG_GDB_PATH="gdb"
CONFIG_PROBE_OPENOCD=y
CONFIG_DISASSEMBLY=y
CONFIG_OPTEE=y
CONFIG_OPTEE_TA_UUID=""
CONFIG_OPTEE_TA_DEV_KIT_DIR=""
CONFIG_OPTEE_TA_SIGN_KEY=""
CONFIG_OPTEE_TA_INSTALL_PATH="/lib/optee_armtz"
CONFIG_OPTEE_TA_LOG_LEVEL=2
CONFIG_OPTEE_TA_STACK_SIZE=2048
CONFIG_OPTEE_TA_DATA_SIZE=32768
# CONFIG_OPTEE_TA_SINGLE_INSTANCE is not set
CONFIG_OPTEE_TA_LIB=y
CONFIG_OPTEE_TA_LIB_STATIC=y
# CONFIG_OPTEE_TA_LIB_SHARED is not set
CONFIG_LICENSE=y
CONFIG_LICENSE_YEAR="2026"
CONFIG_LICENSE_AUTHOR_NAME="Your Name"
CONFIG_LICENSE_APACHE=y
# CONFIG_LICENSE_MIT is not set
CONFIG_ENV_FILE=y
CONFIG_GIT=y
CONFIG_GIT_DEFAULT_BRANCH="main"
# CONFIG_GIT_USER_CONFIG is not set
CONFIG_GIT_FIRST_COMMIT=y
CONFIG_GIT_FIRST_COMMIT_MESSAGE="First commit (with Embark !)"
CONFIG_GIT_ORIGIN=""
CONFIG_JUSTFILE=y
CONFIG_VSCODE=y
CONFIG_VSCODE_RECOMMENDED_EXTENSIONS=y

#
# Docker
#
# CONFIG_DOCKER is not set
# end of Docker

# CONFIG_SERIAL_TERMINAL is not set
